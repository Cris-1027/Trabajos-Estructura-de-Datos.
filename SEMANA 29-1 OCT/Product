package com.mycompany.inventariopoo;

public class Product {
    private int id;
    private String nombre;
    private double precio;
    private int existencia;

    // 1. Constructor con parámetros
    public Product(int id, String nombre, double precio, int existencia) {
        this.id = id;
        this.nombre = nombre;
        this.precio = precio;
        this.existencia = existencia;
    }

    // 1. Constructor vacío (para usar con setters)
    public Product() {
    }

    // 2. Métodos Setters (Modificar atributos)
    public void setId(int id) { this.id = id; }
    public void setNombre(String nombre) { this.nombre = nombre; }
    public void setPrecio(double precio) { this.precio = precio; }
    public void setExistencia(int existencia) { this.existencia = existencia; }

    // 2. Métodos Getters (Consultar atributos)
    public int getId() { return id; }
    public String getNombre() { return nombre; }
    public double getPrecio() { return precio; }
    public int getExistencia() { return existencia; }
}
